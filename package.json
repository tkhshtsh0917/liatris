{
  "name": "liatris",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "profile": "node tools/compile-profile.ts",
    "lint": "biome check src tests tools server demo examples/browser integration/kinesis benchmarks schema/profile.schema.json",
    "format": "biome format --write src tests tools server demo examples/browser integration/kinesis benchmarks schema/profile.schema.json",
    "forward:kinesis": "node tools/forward-kinesis.ts",
    "test:browser": "npm run demo:build && node --test tests/browser/delivery.ts",
    "test:kinesis": "docker compose -f integration/kinesis/compose.yaml up --build --abort-on-container-exit --exit-code-from verification",
    "demo:build": "tsc -p tsconfig.demo.json",
    "demo": "npm run demo:build && node demo/server.ts",
    "sdk:build": "node tools/package-sdk.ts",
    "test:sdk": "node --test tests/distribution/browser.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kinesis": "3.1175.0",
    "@decimalturn/toml-patch": "3.3.3",
    "@smithy/node-http-handler": "4.14.2",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
